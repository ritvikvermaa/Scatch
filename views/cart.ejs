<%- include('./partials/header') %>
<%
let totalMRP = 0;
let totalDiscount = 0;
let platformFee = 20;
groupedCart.forEach(item => {
totalMRP += item.product.price * item.quantity;
totalDiscount += (item.product.discount || 0) * item.quantity;
});
let finalAmount = totalMRP - totalDiscount + platformFee;
%>
<% if(groupedCart.length > 0){ %>
<div class="w-full min-h-screen flex items-start px-20 py-16 gap-10">
<div class="w-[30%]">
<% groupedCart.forEach(function(item,index){ 
    let product = item.product;
%>
<div class="cart-item <%= index === 0 ? '' : 'hidden' %>">
    <div class="rounded-md overflow-hidden shadow">
        <div
            class="relative h-80 flex items-center justify-center"
            style="background-color:<%= product.bgcolor || '#f1f5f9' %>;"
        >
            <button
                type="button"
                class="prevBtn absolute left-4 w-10 h-10 rounded-full bg-white text-black shadow flex items-center justify-center"
            >
                <i class="ri-arrow-left-s-line text-xl"></i>
            </button>
            <img
                class="h-56 object-contain"
                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                alt="<%= product.name %>"
            >
            <button
                type="button"
                class="nextBtn absolute right-4 w-10 h-10 rounded-full bg-white text-black shadow flex items-center justify-center"
            >
                <i class="ri-arrow-right-s-line text-xl"></i>
            </button>
        </div>
        <div
            class="px-5 py-4 flex items-center justify-between"
            style="background-color:<%= product.panelcolor || '#dbeafe' %>; color:<%= product.textcolor || '#000' %>;"
        >
            <h3 class="text-2xl font-medium">
                <%= product.name %>
            </h3>
            <div class="flex items-center gap-2">
                <a
                    href="/cart/remove/<%= product._id %>"
                    class="w-8 h-8 rounded-full bg-white text-black flex items-center justify-center hover:bg-gray-100"
                >
                    <i class="ri-subtract-line"></i>
                </a>
                <div class="bg-white text-black px-3 py-1 rounded font-medium">
                    <%= item.quantity %>
                </div>
                <a
                    href="/cart/add/<%= product._id %>"
                    class="w-8 h-8 rounded-full bg-white text-black flex items-center justify-center hover:bg-gray-100"
                >
                    <i class="ri-add-line"></i>
                </a>
            </div>
        </div>
        <div class="bg-slate-600 text-white px-5 py-3 flex justify-between">
            <span>Net Total</span>
            <span>₹ <%= product.price * item.quantity %></span>
        </div>
    </div>
</div>
<% }) %>
</div>
<div class="w-[70%]">
    <h3 class="text-3xl font-semibold mb-8">
        Price Breakdown
    </h3>
    <div class="space-y-5 text-xl">
        <div class="flex justify-between">
            <span>Total MRP</span>
            <span>₹ <%= totalMRP %></span>
        </div>
        <div class="flex justify-between">
            <span>Discount on MRP</span>
            <span>₹ <%= totalDiscount %></span>
        </div>
        <div class="flex justify-between">
            <span>Platform Fee</span>
            <span>₹ <%= platformFee %></span>
        </div>
        <div class="flex justify-between">
            <span>Shipping Fee</span>
            <span>FREE</span>
        </div>
    </div>
    <div class="w-full h-[1px] bg-gray-400 my-10"></div>
    <div class="flex justify-between items-center">
        <h3 class="text-3xl font-semibold">
            Total Amount
        </h3>
        <h3 class="text-3xl font-semibold text-green-500">
            ₹ <%= finalAmount %>
        </h3>
    </div>
    <button class="mt-10 px-8 py-4 bg-black text-white rounded-md hover:opacity-90">
        Proceed to Checkout
    </button>
</div>
</div>
<script>
const cards = document.querySelectorAll(".cart-item");
let currentIndex = 0;
function showCard(index){
    cards.forEach(card => card.classList.add("hidden"));
    cards[index].classList.remove("hidden");
}
document.querySelectorAll(".nextBtn").forEach(btn=>{
    btn.addEventListener("click",()=>{
        cards[currentIndex].classList.add("hidden");
        currentIndex = (currentIndex + 1) % cards.length;
        cards[currentIndex].classList.remove("hidden");
    });
});
document.querySelectorAll(".prevBtn").forEach(btn=>{
    btn.addEventListener("click",()=>{
        cards[currentIndex].classList.add("hidden");
        currentIndex = (currentIndex - 1 + cards.length) % cards.length;
        cards[currentIndex].classList.remove("hidden");
    });
});
showCard(0);
</script>
<% } else { %>
<div class="w-full min-h-[70vh] flex flex-col items-center justify-center">
<h2 class="text-4xl font-semibold mb-4">
    Your Cart Is Empty
</h2>
<p class="text-gray-500 mb-6">
    Looks like you haven't added any products yet.
</p>
<a href="/shop" class="px-6 py-3 bg-black text-white rounded-md">
    Continue Shopping
</a>
</div>
<% } %>
<%- include('./partials/footer') %>